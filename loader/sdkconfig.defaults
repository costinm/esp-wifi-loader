CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_FREERTOS_UNICORE=n
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_IN_IRAM=y
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_LWIP_IRAM_OPTIMIZATION=y
CONFIG_LWIP_TCPIP_TASK_PRIO=23
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_BOOTLOADER_RESERVE_RTC_MEM=y
CONFIG_BOOTLOADER_RESERVE_RTC_SIZE=0x10
CONFIG_BOOTLOADER_CUSTOM_RESERVE_RTC=y
CONFIG_BOOTLOADER_CUSTOM_RESERVE_RTC_SIZE=0x20
CONFIG_SPI_FLASH_DANGEROUS_WRITE_ALLOWED=y
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
# ESP-IDF wifi/iperf baseline; CPU-specific buffer/window settings below.
CONFIG_LWIP_TCP_RECVMBOX_SIZE=64
CONFIG_LWIP_UDP_RECVMBOX_SIZE=64
# Separate from the per-socket mailbox: Wi-Fi -> lwIP input queue.
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64
# Single upload: retain out-of-order data within receive credit instead of
# discarding after four pbufs. SACK lets the host retransmit missing ranges.
# Retained pbufs also hold Wi-Fi RX buffers; validate heap/RX headroom on-device.
CONFIG_LWIP_TCP_QUEUE_OOSEQ=y
CONFIG_LWIP_TCP_SACK_OUT=y
CONFIG_LWIP_TCP_OOSEQ_MAX_PBUFS=0
# Recovery stays awake: shorter delayed-ACK timer after a loss shrinks cwnd.
CONFIG_LWIP_TCP_TMR_INTERVAL=50
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=64
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=64
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=y
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=y
CONFIG_ESP_WIFI_RX_BA_WIN=32
CONFIG_ESP_WIFI_TX_BA_WIN=32
CONFIG_LWIP_STATS=y
# Keep watchdogs and PHY tracking: the demo disables these for lab experiments,
# not as requirements for its TCP receive path.
# The loader never writes NVS and does not link it; Wi-Fi config and PHY
# calibration must not be persisted either (both default to NVS writes).
CONFIG_ESP_WIFI_NVS_ENABLED=n
CONFIG_ESP_PHY_CALIBRATION_AND_DATA_STORAGE=n
# WPA2-PSK networks with a public constant passphrase; no WPA3, no home credentials, no NVS.
CONFIG_ESP_WIFI_ENABLE_WPA3_SAE=n
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y
# Link-local IPv6 only: no SLAAC/global address, no DHCPv6, no DNS resolver.
CONFIG_LWIP_IPV6=y
CONFIG_LWIP_IPV6_AUTOCONFIG=n
CONFIG_LWIP_IPV6_DHCP6=n
CONFIG_LWIP_DHCP_DOES_ARP_CHECK=n
CONFIG_LWIP_IPV6_NUM_ADDRESSES=3
# Console: UART0 (the default) with USB-Serial/JTAG as secondary output, so a board gets logs
# on whichever is connected; ESP_CONSOLE_USB_SERIAL_JTAG as primary would silence UART boards.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y

# Match the C XIP comparison: preserve checks, omit verbose locations/messages.
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_SILENT=y
CONFIG_COMPILER_OPTIMIZATION_CHECKS_SILENT=y
CONFIG_LWIP_ESP_LWIP_ASSERT=y
CONFIG_LWIP_DEBUG=n
